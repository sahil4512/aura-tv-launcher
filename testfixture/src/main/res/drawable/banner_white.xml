<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 banner on a white background, like Netflix / YouTube / Amazon Live. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#FFFFFF" /><size android:width="320dp" android:height="180dp" /></shape></item>
    <item android:left="100dp" android:right="100dp" android:top="60dp" android:bottom="60dp">
        <shape><solid android:color="#E50914" /><corners android:radius="8dp" /></shape>
    </item>
</layer-list>
